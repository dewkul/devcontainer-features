{
    "name": "Android SDK",
    "id": "android-sdk",
    "version": "0.0.1",
    "description": "",
    "options": {
        "sdkComponents": {
            "type": "string",
            "default": "platform-tools",
            "description": "Enter components to install, split multiple components by comma ` `"
        },
        "androidHome": {
            "type": "string",
            "default": "/home/vscode/.android",
